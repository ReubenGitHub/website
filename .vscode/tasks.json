{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start React Dev Server (Hot Reload)",
            "type": "shell",
            "command": "npm start",
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "focus": true,
                "group": "build",
                "showReuseMessage": false,
                "clear": false
            },
            "isBackground": true,
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "runOptions": {
                "runOn": "folderOpen"
            }
        }
    ]
}
