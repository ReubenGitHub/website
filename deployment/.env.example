# MyWebsite Production Environment Variables
# Copy this file to .env and fill in the values

# AWS Configuration
AWS_REGION=eu-west-2
AWS_ECR_REGISTRY=public.ecr.aws
AWS_ECR_NAMESPACE=reubenhow
AWS_ACCOUNT_ID=your-account-id-here

# Domain Configuration
DOMAIN=reubenhow.com
FRONTEND_URL=https://reubenhow.com
WWW_FRONTEND_URL=https://www.reubenhow.com

# Container Registry
IMAGE_TAG=latest

# ECS Configuration
ECS_CLUSTER=mywebsite-production
ECS_SERVICE=mywebsite-production
ECS_TASK_DEFINITION=mywebsite-production

# Logging Configuration
DOTNET_LOG_LEVEL=Warning
FLASK_LOG_LEVEL=Warning

# Security (if using HTTPS/SSL)
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem
