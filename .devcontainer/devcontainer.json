{
    "name": "MyWebsite Dev",
    "dockerComposeFile": "docker-compose.yml",
    "service": "dev",
    "workspaceFolder": "/app",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.debugpy",
                "ms-dotnettools.csharp"
            ]
        }
    },
    "forwardPorts": [3000, 5000, 5001],
    "remoteUser": "root",
    "overrideCommand": false
}
